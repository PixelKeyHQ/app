{
  "name": "pixel-key-desktop",
  "productName": "Pixel Key",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "author": "Rake <usage-rake-pennant@duck.com>",
  "homepage": "https://github.com/PixelKeyHQ/pixelkey",
  "desktopName": "pixel-key-desktop.desktop",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "node build.mjs",
    "start": "npm run build && electron .",
    "typecheck": "tsc --noEmit",
    "test": "node --import ../node_modules/tsx/dist/loader.mjs --test test/*.test.ts",
    "test:smoke": "npm run build && playwright test",
    "package": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "electron": "44.7.2",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "typescript": "~6.0.3"
  },
  "build": {
    "appId": "io.github.pixelkeyhq.desktop",
    "productName": "Pixel Key",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*"
    ],
    "asar": true,
    "artifactName": "Pixel-Key-${version}-${os}-${arch}.${ext}",
    "mac": {
      "category": "public.app-category.utilities",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "hardenedRuntime": true,
      "identity": "-",
      "notarize": false,
      "entitlements": "entitlements.mac.plist",
      "entitlementsInherit": "entitlements.mac.plist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "category": "Utility",
      "target": [
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0",
        "libasound2t64 | libasound2"
      ]
    },
    "publish": null,
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "grantFileProtocolExtraPrivileges": false
    },
    "icon": "../assets/icon.png"
  },
  "description": "Generate a backup profile locally from your own Google account.",
  "engines": {
    "node": ">=22.13.0"
  },
  "overrides": {
    "@electron/get": "5.1.0"
  }
}
